# Tavily API key (server-side only; never exposed to the frontend). Get one at https://tavily.com
TAVILY_API_KEY=
# SQLAlchemy URL. Relative sqlite paths resolve from the directory you start the server in.
DATABASE_URL=sqlite:///./career_engine.db
# Used to HMAC anonymous session ids before storing them. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
